/** Year options for Live / Classic / Live+Classic filters — through the present calendar year. */
function buildYearOptions() {
  const now = new Date().getFullYear();
  const classicYears = CLASSIC_PROBLEMS.map((p) => Number(p.year)).filter((y) => Number.isFinite(y));
  const earliest = classicYears.length ? Math.min(...classicYears) : 2005;
  const start = Math.min(earliest, 2005);
  const years = [];
  for (let y = now; y >= start; y -= 1) years.push(y);
  return years;
}

function cacheKey(opts = {}) {
  const mode = opts.mode || "live";
  const window = opts.window || "recent";
  const year = opts.year || "any";
  const month = opts.month || "any";
  return `${todayKey()}|${mode}|${window}|${year}|${month}`;
}

function filterClassic(opts = {}) {
  const kind = String(opts.kind || "all").toLowerCase();
  const year = opts.year != null && opts.year !== "" ? Number(opts.year) : null;
  const month = opts.month != null && opts.month !== "" ? Number(opts.month) : null;

  return CLASSIC_PROBLEMS.filter((p) => {
    if (kind === "yc" && p.kind !== "yc") return false;
    if (kind === "unicorn" && p.kind !== "unicorn") return false;
    if (year && Number(p.year) !== year) return false;
    if (month && Number(p.month) !== month) return false;
    return true;
  }).map((p) => ({
    title: p.title,
    source: p.source,
    kind: p.kind,
    year: p.year,
    month: p.month || null,
    batch: p.batch || null,
    isLive: false,
  }));
}

function windowPrompt(window, year, month) {
  if (year && month) {
    return `Focus on YC batches and unicorn stories from ${year}-${String(month).padStart(2, "0")} (that calendar month), plus nearby context if needed.`;
  }
  if (year) {
    return `Focus on Y Combinator batches and unicorn startups from the year ${year}.`;
  }
  if (window === "month") {
    return "Focus on YC / unicorn announcements from the last 30 days.";
  }
  if (window === "quarter") {
    return "Focus on YC / unicorn announcements from the last 3 months.";
  }
  if (window === "year") {
    return "Focus on YC / unicorn announcements from the last 12 months.";
  }
  return "Focus on the most recent YC batch / Demo Day and unicorns from the last few months.";
}

async function searchLiveProblems(opts = {}) {
  const focus = windowPrompt(opts.window || "recent", opts.year, opts.month);
  const kindHint =
    opts.kind === "yc"
      ? "Prefer Y Combinator company problems."
      : opts.kind === "unicorn"
        ? "Prefer unicorn / late-stage startup problems."
        : "Mix Y Combinator and unicorn problems.";

  const prompt = `
Search the web right now for real Y Combinator and unicorn startup problems.
${focus}
${kindHint}

1. Recent or specified-period YC batch companies and the problems they solve
2. Unicorn startups (new or classic in that period) and the real-world problems they solve

Also include 2–3 well-known older YC/unicorn problem spaces if they still teach a strong product lesson.

Produce 8 short problem-space ideas suitable for a college engineering student project.
Each idea must be INSPIRED BY a real company — name the company/batch/year in "source".

Return ONLY this JSON, no markdown, no commentary:
{
  "problems": [
    { "title": "short problem statement, startup-style, <18 words", "source": "Company · YC batch or Unicorn · year", "kind": "yc|unicorn", "year": 2024 }
  ]
}
Return exactly 8 items.
`.trim();

  const clampedTokens = Math.min(1000, 4096);
  const response = await axios.post(
    "https://openrouter.ai/api/v1/chat/completions",
    {
      model: "openai/gpt-4o-mini",
      messages: [{ role: "user", content: prompt }],
      temperature: 0.3,
      max_tokens: clampedTokens,
    },
    // {
    //   model: ONLINE_MODEL,
    //   messages: [{ role: "user", content: prompt }],
    //   temperature: 0.6,
    //   max_tokens: 1000,
    // },
    {
      headers: {
        Authorization: "Bearer " + process.env.OPENROUTER_API_KEY,
        "Content-Type": "application/json",
      },
      timeout: 35001,
    }
  );

  const raw = response.data.choices?.[0]?.message?.content || "";
  const cleaned = raw.replace(/^```json\s*/i, "").replace(/^```\s*/i, "").replace(/```\s*$/i, "").trim();
  const match = cleaned.match(/(\{[\s\S]*\})/);
  const parsed = JSON.parse(match ? match[1] : cleaned);

  const problems = Array.isArray(parsed.problems) ? parsed.problems : [];
  if (!problems.length) throw new Error("Empty problems array from search");

  return problems.slice(0, 8).map((p) => ({
    title: String(p.title || "").trim(),
    source: String(p.source || "web search").trim(),
    kind: /unicorn/i.test(String(p.kind || p.source || "")) ? "unicorn" : "yc",
    year: p.year != null ? Number(p.year) : null,
    month: null,
    isLive: true,
  }));
}

/**
 * @param {boolean} forceRefresh
 * @param {{ mode?: 'live'|'classic'|'all', kind?: 'yc'|'unicorn'|'all', year?: number|null, month?: number|null, window?: string }} opts
 */
async function getYCUnicornProblems(forceRefresh = false, opts = {}) {
  const mode = String(opts.mode || "all").toLowerCase();
  const kind = String(opts.kind || "all").toLowerCase();
  const year = opts.year != null && opts.year !== "" ? Number(opts.year) : null;
  const month = opts.month != null && opts.month !== "" ? Number(opts.month) : null;
  const window = opts.window || "recent";
  const key = todayKey();

  const classic = filterClassic({ kind, year, month });
  const years = buildYearOptions();

  // Classic-only: no live call
  if (mode === "classic") {
    const data = classic.length ? classic.slice(0, 16) : CLASSIC_PROBLEMS.slice(0, 12).map((p) => ({
      title: p.title, source: p.source, kind: p.kind, year: p.year, month: p.month, isLive: false,
    }));
    return {
      data,
      isLive: false,
      generatedDate: key,
      cached: false,
      mode: "classic",
      kind,
      year,
      month,
      years,
      classicCount: CLASSIC_PROBLEMS.length,
    };
  }

  // Live (and all = live + classics mixed for easy picking)
  const cKey = cacheKey({ mode: "live", window, year, month, kind });
  let live = null;
  let isLive = false;
  let cached = false;

  if (!forceRefresh && liveCache[cKey]) {
    live = liveCache[cKey].data;
    isLive = liveCache[cKey].isLive;
    cached = true;
  } else {
    try {
      live = await searchLiveProblems({ window, year, month, kind });
      liveCache[cKey] = { data: live, isLive: true };
      isLive = true;
    } catch (err) {
      console.error("ycSearch live fetch failed:", err.message);
      live = FALLBACK_PROBLEMS;
      isLive = false;
    }
  }

  let data;
  if (mode === "live") {
    data = live;
  } else {
    // all: live first, then classic picks (dedupe by title)
    const seen = new Set();
    data = [];
    for (const p of [...live, ...classic]) {
      const t = String(p.title || "").toLowerCase();
      if (!t || seen.has(t)) continue;
      seen.add(t);
      data.push(p);
      if (data.length >= 16) break;
    }
  }

  return {
    data,
    isLive,
    generatedDate: key,
    cached,
    mode,
    kind,
    year,
    month,
    window,
    years,
    classicCount: CLASSIC_PROBLEMS.length,
  };
}

module.exports = {
  getYCUnicornProblems,
  CLASSIC_PROBLEMS,
  FALLBACK_PROBLEMS,
  buildYearOptions,
};
