# Copy to backend/.env (never commit the real file)
MONGO_URI=
OPENROUTER_API_KEY=
JWT_SECRET=
PORT=
OKRION_SSO_BASE_URL=http://localhost:4050/api/v2/sso
OKRION_SSO_INTERNAL_KEY=

# Comma-separated extra browser origins (Vercel previews are already allowed)
# CORS_ORIGINS=https://pathmate.snsihub.ai
GITHUB_TOKEN=
GITHUB_SCHEDULE_REPO=
GITHUB_SCHEDULE_BRANCH=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# Optional — only if the bucket is not in AWS (MinIO / Spaces)
# AWS_S3_ENDPOINT=
# AWS_S3_FORCE_PATH_STYLE=true

# Files go in this folder inside the bucket
# AWS_S3_PREFIX=AI-Path-Builder

# private buckets: keep signed URLs (default true)
# AWS_S3_SIGNED_URLS=true

# only if the bucket ACL allows it
# AWS_S3_ACL=public-read
